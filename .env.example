APP_NAME="WLS Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wls_portal
DB_USERNAME=wls
DB_PASSWORD=wls

# Separate Datenbank für die Test-Suite.
DB_TEST_DATABASE=wls_portal_test

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PREFIX=wls_portal_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portal@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Privater S3-kompatibler Object Storage für Dokumente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Ablage der Dokumente. In Produktion der private S3-kompatible Speicher.
DOCUMENTS_DISK=s3
DOCUMENTS_MAX_SIZE_MB=100

# MCP-Zugang für KI-Clients. Der Endpunkt trägt volle Schreibrechte,
# einschließlich endgültigem Löschen — MCP_ENABLED=false schaltet ihn ab.
# Tokens: php artisan portal:mcp-token ausstellen --email=…
MCP_ENABLED=true
MCP_PATH=mcp/portal
MCP_RATE_LIMIT=60,1
MCP_TOKEN_EXPIRATION_DAYS=90

VITE_APP_NAME="${APP_NAME}"

# Die Zugangsdaten der Domain-Schnittstellen stehen NICHT hier, sondern
# verschlüsselt in der Datenbank; gepflegt werden sie unter Schnittstellen.
# Überschrieben werden muss hier nur ein abweichender Endpunkt, etwa für ein
# Testsystem.
# AUTODNS_ENDPOINT=
# Der Kontext ist 4 (Livesystem) und voreingestellt; 1 waere das Testsystem.
# AUTODNS_CONTEXT=
